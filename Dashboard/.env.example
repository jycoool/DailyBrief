# 把這份複製成 .env，並把三個值換成 python drive_backup.py --authorize 印出的真實值。
# 注意：值前後不要有空格、不要加引號。refresh token 與 secret 是機密，勿 commit。
GOOGLE_DRIVE_REFRESH_TOKEN=1//....apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-....

# 選填：目標 Drive 資料夾名稱（找不到會自動建立）
GOOGLE_DRIVE_FOLDER_NAME=每日初判

# 啟用 daily_brief.py 產出後「自動備份到 Google Drive」（設 1 才啟用，預設關閉）
GOOGLE_DRIVE_ENABLED=1